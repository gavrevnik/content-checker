{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "moods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 80},
          "item_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "required": ["label", "item_ids"]
      }
    }
  },
  "required": ["moods"]
}
